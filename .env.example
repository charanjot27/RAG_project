# Copy this file to .env and fill in your values. NEVER commit .env.

# --- Generation ------------------------------------------------------------
# Which LLM writes the final answer. Only this step calls an LLM.
#   groq      -> free & fast (default). Get a key: https://console.groq.com/keys
#   anthropic -> Claude API (paid).
LLM_PROVIDER=groq

# Groq (free). Required when LLM_PROVIDER=groq. Put the REAL key in .env, never here.
GROQ_API_KEY=gsk_your-groq-key-here
# GROQ_MODEL=openai/gpt-oss-120b   # list yours: see the note in src/config.py

# Anthropic (paid). Required only when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Retrieval mode --------------------------------------------------------
# local      -> answer from YOUR indexed documents (data/raw + Qdrant below)
# web        -> LIVE WEB SEARCH (no uploads; the internet is the corpus)
# web_cached -> web search, but fetched pages are cached into Qdrant so repeat/
#               related questions are instant and the index grows over time
RETRIEVAL_MODE=local
# WEB_RESULTS=5              # pages to fetch per question (web / web_cached)
# WEB_MAX_CHUNKS_PER_PAGE=6
# WEB_CACHE_MIN_HITS=5       # web_cached: cache hits before skipping the web call
# WEB_CACHE_SIM_THRESHOLD=0.55

# --- Trust controls --------------------------------------------------------
# Abstention: if an answer's faithfulness is below this, VeriFin REFUSES to
# answer instead of risking a hallucination. 0.0 = off; 0.5 = a good start.
# ABSTAIN_THRESHOLD=0.0

# --- Vector store (used in local mode) -------------------------------------
# Easiest: embedded on-disk Qdrant — NO Docker, NO server. Just set a folder:
QDRANT_PATH=qdrant_data
# Or run a local Qdrant server (docker run -p 6333:6333 qdrant/qdrant) and
# comment QDRANT_PATH out to use host+port instead:
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# Or Qdrant Cloud (takes precedence over host/port; leave QDRANT_PATH unset):
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-key

# --- Optional tuning -------------------------------------------------------
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
# ENTAILMENT_THRESHOLD=0.5
# CHUNK_SIZE=400
# CHUNK_OVERLAP=50
# RETRIEVE_K=20
# TOP_N=5

# --- API / CORS ------------------------------------------------------------
# Comma-separated allowed origins for the browser UI. "*" is fine for a demo;
# set it to your deployed Streamlit URL for real use.
# ALLOWED_ORIGINS=*
# When used as the knowledge layer of FinTrace, allow the FinSim dev origins so
# the game's "Ask Mira" panel can call POST /ask from the browser:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Run VeriFin on a spare port so it doesn't clash with FinTrace (which uses 8000):
#   uvicorn api.main:app --port 8100
# See docs/FINTRACE_INTEGRATION.md.

# --- Frontend --------------------------------------------------------------
# Where the Streamlit app finds the API (default: http://localhost:8000)
# API_URL=http://localhost:8000
