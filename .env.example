# Copy this file to .env and fill in your values. NEVER commit .env.

# --- Generation ------------------------------------------------------------
# Which LLM writes the final answer. Only this step calls an LLM.
#   groq      -> free & fast (default). Get a key: https://console.groq.com/keys
#   anthropic -> Claude API (paid).
LLM_PROVIDER=groq

# Groq (free). Required when LLM_PROVIDER=groq.
GROQ_API_KEY=gsk_your-groq-key-here
# GROQ_MODEL=llama-3.3-70b-versatile   # see https://console.groq.com/docs/models

# Anthropic (paid). Required only when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Vector store ----------------------------------------------------------
# Local Qdrant (docker compose / docker run) uses host+port:
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Qdrant Cloud instead? Set these and they take precedence over host/port:
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-key

# --- Optional tuning -------------------------------------------------------
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
# ENTAILMENT_THRESHOLD=0.5
# CHUNK_SIZE=400
# CHUNK_OVERLAP=50
# RETRIEVE_K=20
# TOP_N=5

# --- API / CORS ------------------------------------------------------------
# Comma-separated allowed origins for the browser UI. "*" is fine for a demo;
# set it to your deployed Streamlit URL for real use.
# ALLOWED_ORIGINS=*

# --- Frontend --------------------------------------------------------------
# Where the Streamlit app finds the API (default: http://localhost:8000)
# API_URL=http://localhost:8000
